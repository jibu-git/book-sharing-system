<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.Message.mapper.TMessageMapper">
    
    <resultMap type="TMessage" id="TMessageResult">
        <result property="msgId"    column="msg_id"    />
        <result property="senderId"    column="sender_id"    />
        <result property="receiverId"    column="receiver_id"    />
        <result property="msgType"    column="msg_type"    />
        <result property="title"    column="title"    />
        <result property="content"    column="content"    />
        <result property="relatedId"    column="related_id"    />
        <result property="isRead"    column="is_read"    />
        <result property="createTime"    column="create_time"    />
    </resultMap>

    <sql id="selectTMessageVo">
        select msg_id, sender_id, receiver_id, msg_type, title, content, related_id, is_read, create_time from t_message
    </sql>

    <select id="selectTMessageList" parameterType="TMessage" resultMap="TMessageResult">
        <include refid="selectTMessageVo"/>
        <where>  
            <if test="senderId != null "> and sender_id = #{senderId}</if>
            <if test="receiverId != null "> and receiver_id = #{receiverId}</if>
            <if test="msgType != null  and msgType != ''"> and msg_type = #{msgType}</if>
            <if test="title != null  and title != ''"> and title = #{title}</if>
            <if test="content != null  and content != ''"> and content = #{content}</if>
            <if test="relatedId != null "> and related_id = #{relatedId}</if>
            <if test="isRead != null  and isRead != ''"> and is_read = #{isRead}</if>
        </where>
    </select>
    
    <select id="selectTMessageByMsgId" parameterType="Long" resultMap="TMessageResult">
        <include refid="selectTMessageVo"/>
        where msg_id = #{msgId}
    </select>

    <insert id="insertTMessage" parameterType="TMessage" useGeneratedKeys="true" keyProperty="msgId">
        insert into t_message
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="senderId != null">sender_id,</if>
            <if test="receiverId != null">receiver_id,</if>
            <if test="msgType != null and msgType != ''">msg_type,</if>
            <if test="title != null and title != ''">title,</if>
            <if test="content != null and content != ''">content,</if>
            <if test="relatedId != null">related_id,</if>
            <if test="isRead != null">is_read,</if>
            <if test="createTime != null">create_time,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="senderId != null">#{senderId},</if>
            <if test="receiverId != null">#{receiverId},</if>
            <if test="msgType != null and msgType != ''">#{msgType},</if>
            <if test="title != null and title != ''">#{title},</if>
            <if test="content != null and content != ''">#{content},</if>
            <if test="relatedId != null">#{relatedId},</if>
            <if test="isRead != null">#{isRead},</if>
            <if test="createTime != null">#{createTime},</if>
         </trim>
    </insert>

    <update id="updateTMessage" parameterType="TMessage">
        update t_message
        <trim prefix="SET" suffixOverrides=",">
            <if test="senderId != null">sender_id = #{senderId},</if>
            <if test="receiverId != null">receiver_id = #{receiverId},</if>
            <if test="msgType != null and msgType != ''">msg_type = #{msgType},</if>
            <if test="title != null and title != ''">title = #{title},</if>
            <if test="content != null and content != ''">content = #{content},</if>
            <if test="relatedId != null">related_id = #{relatedId},</if>
            <if test="isRead != null">is_read = #{isRead},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
        </trim>
        where msg_id = #{msgId}
    </update>

    <delete id="deleteTMessageByMsgId" parameterType="Long">
        delete from t_message where msg_id = #{msgId}
    </delete>

    <delete id="deleteTMessageByMsgIds" parameterType="String">
        delete from t_message where msg_id in 
        <foreach item="msgId" collection="array" open="(" separator="," close=")">
            #{msgId}
        </foreach>
    </delete>
</mapper>