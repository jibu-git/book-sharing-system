<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.tCart.mapper.TCartMapper">

    <resultMap type="TCart" id="TCartResult">
        <result property="cartId"    column="cart_id"    />
        <result property="userId"    column="user_id"    />
        <result property="cartBooksId"    column="cart_books_id"    />
        <result property="cartNum"    column="cart_num"    />
        <result property="createTime"    column="create_time"    />
        <result property="remark"    column="remark"    />
    </resultMap>

    <sql id="selectTCartVo">
        select cart_id, user_id, cart_books_id, cart_num, create_time, remark from t_cart
    </sql>

    <select id="selectTCartList" parameterType="TCart" resultMap="TCartResult">
        <include refid="selectTCartVo"/>
        <where>
            <if test="cartBooksId != null "> and cart_books_id = #{cartBooksId}</if>
        </where>
    </select>

    <select id="selectTCartByCartId" parameterType="Long" resultMap="TCartResult">
        <include refid="selectTCartVo"/>
        where cart_id = #{cartId}
    </select>

    <insert id="insertTCart" parameterType="TCart" useGeneratedKeys="true" keyProperty="cartId">
        insert into t_cart
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="userId != null">user_id,</if>
            <if test="cartBooksId != null">cart_books_id,</if>
            <if test="cartNum != null">cart_num,</if>
            <if test="createTime != null">create_time,</if>
            <if test="remark != null">remark,</if>
         </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="userId != null">#{userId},</if>
            <if test="cartBooksId != null">#{cartBooksId},</if>
            <if test="cartNum != null">#{cartNum},</if>
            <if test="createTime != null">#{createTime},</if>
            <if test="remark != null">#{remark},</if>
         </trim>
    </insert>

    <update id="updateTCart" parameterType="TCart">
        update t_cart
        <trim prefix="SET" suffixOverrides=",">
            <if test="userId != null">user_id = #{userId},</if>
            <if test="cartBooksId != null">cart_books_id = #{cartBooksId},</if>
            <if test="cartNum != null">cart_num = #{cartNum},</if>
            <if test="createTime != null">create_time = #{createTime},</if>
            <if test="remark != null">remark = #{remark},</if>
        </trim>
        where cart_id = #{cartId}
    </update>

    <delete id="deleteTCartByCartId" parameterType="Long">
        delete from t_cart where cart_id = #{cartId}
    </delete>

    <delete id="deleteTCartByCartIds" parameterType="String">
        delete from t_cart where cart_id in
        <foreach item="cartId" collection="array" open="(" separator="," close=")">
            #{cartId}
        </foreach>
    </delete>

    <select id="selectTCartListByIds" parameterType="Long" resultMap="TCartResult">
        <include refid="selectTCartVo"/>
        where cart_id in
        <foreach item="cartId" collection="array" open="(" separator="," close=")">
            #{cartId}
        </foreach>
    </select>
</mapper>